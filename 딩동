function closeSchedule() {

  document
    .getElementById(
      "schedule-page"
    )
    .style.display =
      "none";

}


/* =========================
   체크
========================= */

function isChecked(
  day,
  period
) {

  return !!appData.checks[

    day
    +
    "-"
    +
    period

  ];

}


function toggleCheck(
  day,
  period,
  type
) {

  const key =

    day
    +
    "-"
    +
    period;


  appData.checks[key] =

    !appData.checks[key];


  saveLocalData();


  openListModal(
    day,
    type
  );

}


/* =========================
   과목 목록
========================= */

function openListModal(
  day,
  type
) {

  document
    .getElementById(
      "list-modal-title"
    )
    .innerText =

      type === "morning"

        ? "🌤 오전수업"

        : "🌷 오후수업";


  const container =
    document.getElementById(
      "schedule-list-container"
    );


  container.innerHTML =
    "";


  const times = [

    [
      "1교시",
      "morning"
    ],

    [
      "2교시",
      "morning"
    ],

    [
      "3교시",
      "morning"
    ],

    [
      "4교시",
      "morning"
    ],

    [
      "5교시",
      "afternoon"
    ],

    [
      "6교시",
      "afternoon"
    ]

  ];


  times
    .filter(
      item =>
        item[1]
        ===
        type
    )
    .forEach(

      item => {

        const period =
          item[0];


        const key =

          day
          +
          "-"
          +
          period;


        const subject =

          appData
            .overrides[key]

          ||

          (
            defaultSchedule[day]
            &&
            defaultSchedule[day][
              parseInt(period) - 1
            ]
          );


        if (!subject) {

          return;

        }


        const checked =

          isChecked(
            day,
            period
          );


        const itemBox =

          document.createElement(
            "div"
          );


        itemBox.className =

          "schedule-item"

          +

          (
            checked
              ? " done"
              : ""
          );


        itemBox.onclick =
          () => {

            openVideoModal(

              day,

              period,

              subject

            );

          };


        const color =

          subjectColorMap[
            subject
          ]

          ||

          "#eef4ff";


        itemBox.innerHTML = `

          <div
            class="item-period-pill"
          >

            <span>

              ${period}

            </span>

          </div>


          <div
            class="item-content-zone"
          >

            <div
              class="subject-badge"
              style="
                background:
                ${color}
              "
            >

              ${iconMap[subject] || "⭐"}

            </div>


            <b
              class="item-subject"
            >

              ${subject}

            </b>

          </div>


          <button

            class="
              subject-check
              ${checked ? "done" : ""}
            "

            onclick="
              event.stopPropagation();

              toggleCheck(
                '${day}',
                '${period}',
                '${type}'
              );
            "

          >

            ${checked ? "✓" : ""}

          </button>

        `;


        container.appendChild(
          itemBox
        );

      }

    );


  document
    .getElementById(
      "list-modal"
    )
    .style.display =
      "flex";

}


function closeListModal() {

  document
    .getElementById(
      "list-modal"
    )
    .style.display =
      "none";

}


/* =========================
   영상 / 메시지
========================= */

function openVideoModal(
  day,
  id,
