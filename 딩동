function formatRealTime(
  decimal
) {

  const hours =
    Math.floor(
      decimal
    );


  const minutes =
    Math.round(

      (
        decimal - hours
      ) * 60

    );


  return (

    String(hours)
      .padStart(
        2,
        "0"
      )

    +

    ":"

    +

    String(minutes)
      .padStart(
        2,
        "0"
      )

  );

}


