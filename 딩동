      title;


  const videoArea =
    document.getElementById(
      "video-area"
    );


  const description =
    document.getElementById(
      "video-desc"
    );


  const key =
    day
    +
    "-"
    +
    id;


  const videoRequired = [

    "1교시",

    "2교시",

    "3교시",

    "4교시",

    "5교시",

    "6교시",

    "감각치료",

    "등교"

  ];


  if (
    !videoRequired.includes(
      id
    )
  ) {

    videoArea.style.display =
      "none";


    const messages = {

      "잠":
        "오늘도 수고했어요. 편안하게 쉬어요! 🌙",

      "기상":
        "좋은 아침이에요! 오늘도 즐겁게 시작해요. ☀️",

      "하교":
        "학교 일정이 끝났어요. 조심히 이동해요! 🏠",

      "집으로":
        "집으로 이동할 시간이에요. 👟",

      "자유시간":
        "즐거운 자유시간이에요! 🎮"

    };


    description.innerText =

      appData
        .descriptions[key]

      ||

      messages[id]

      ||

      title
      +
      " 시간이에요! ✨";

  }

  else {

    videoArea.style.display =
      "flex";


    if (
      appData.urls[key]
    ) {

      videoArea.innerHTML = `

        <video

          src="${appData.urls[key]}"

          controls

          autoplay

          muted

          playsinline

        ></video>

      `;

    }

    else {

      videoArea.innerHTML = `

        <div
          style="
            color:white;
            font-weight:bold;
          "
        >

          🎥 등록된 영상이 없습니다.

        </div>

      `;

    }


    description.innerText =

      appData
        .descriptions[key]

      ||

      "천천히 확인해 보아요. 😊";

  }


  document
    .getElementById(
      "msg-modal"
    )
    .style.display =
      "flex";

}


function closeModal() {

  document
    .getElementById(
      "msg-modal"
    )
    .style.display =
      "none";


  document
    .getElementById(
      "video-area"
    )
    .innerHTML =
      "";

