/* =========================
   관리자 탭
========================= */

function switchAdminTab(
  tab
) {

  [
    "schedule",
    "info",
    "lunch"
  ]
  .forEach(

    name => {

      document
        .getElementById(
          "tab-btn-" + name
        )
        .classList
        .remove(
          "active"
        );


      document
        .getElementById(
          "tab-content-" + name
        )
        .style.display =
          "none";

    }

  );


  document
    .getElementById(
      "tab-btn-" + tab
    )
    .classList
    .add(
      "active"
    );


  document
    .getElementById(
      "tab-content-" + tab
    )
    .style.display =
      "block";


  if (
    tab === "schedule"
  ) {

    updateAdminFields();

  }

  else if (
    tab === "info"
  ) {

    loadCurrentInfoData();

  }

  else {

    loadCurrentLunchData();

  }

}


/* =========================
   관리자 시간표
========================= */

function updateAdminFields() {

  const day =

    document
      .getElementById(
        "admin-schedule-day"
      )
      .value;


  const weekend =

    day === "토요일"

    ||

    day === "일요일";


  document
    .getElementById(
      "admin-weekday-zone"
    )
    .style.display =

      weekend
        ? "none"
        : "block";


  document
    .getElementById(
      "admin-weekend-zone"
    )
    .style.display =

      weekend
        ? "block"
        : "none";


  if (weekend) {

    document
      .getElementById(
        "admin-weekend-text"
      )
      .value =

        (
          appData
            .weekendSchedules[day]
          ||
          []
        )

        .map(

          item =>

            formatRealTime(
              item.s
            )

            +

            "~"

            +

            formatRealTime(
              item.e
            )

            +

            " "

            +

            item.label

        )

        .join(
          "\n"
        );

  }

  else {

    const period =

      document
        .getElementById(
          "admin-schedule-period"
        )
        .value;


    const key =

      day
      +
      "-"
      +
      period;


    document
      .getElementById(
        "admin-schedule-desc"
      )
      .value =

        appData
          .descriptions[key]

        ||

        "";


    document
      .getElementById(
        "admin-video-url"
      )
      .value =

        appData
          .urls[key]

        ||

        "";

  }

}


/* =========================
   시간표 저장
========================= */

function saveScheduleVideoData() {

  const day =

    document
      .getElementById(
        "admin-schedule-day"
      )
      .value;


  const period =

    document
      .getElementById(
        "admin-schedule-period"
      )
      .value;


  const key =

    day
    +
    "-"
    +
    period;


  appData.overrides[key] =

    document
      .getElementById(
        "admin-schedule-subject"
      )
      .value;


  appData.descriptions[key] =

    document
      .getElementById(
        "admin-schedule-desc"
      )
      .value;


  appData.urls[key] =

    document
      .getElementById(
        "admin-video-url"
      )
      .value
      .trim();


  saveLocalData();


  alert(
    "저장되었습니다."
  );

}


/* =========================
   주말 저장
========================= */

function saveWeekendScheduleData() {

  const day =

    document
      .getElementById(
        "admin-schedule-day"
      )
      .value;


  const text =

    document
      .getElementById(
        "admin-weekend-text"
      )
      .value;


  const items = [];


  text
    .split(
      "\n"
    )
    .forEach(

      line => {

        const match =

          line.match(

            /^(\d{2}):(\d{2})\s*~\s*(\d{2}):(\d{2})\s+(.+)$/

          );


        if (match) {

          items.push({

            s:

              Number(match[1])

              +

              Number(match[2])
              /
              60,


            e:

              Number(match[3])

              +

              Number(match[4])
              /
              60,


            label:

              match[5]
                .trim()

          });

        }

      }

    );


  appData
    .weekendSchedules[day] =
      items;


  saveLocalData();


  alert(
    "저장되었습니다."
  );

}


/* =========================
   준비물 / 소통창 관리자
========================= */

function loadCurrentInfoData() {

  const type =

    document
      .getElementById(
        "admin-info-type"
      )
      .value;


  document
    .getElementById(
      "admin-info-text"
    )
    .value =

      (
        type === "supplies"

          ? appData.supplies

          : appData.chat

      )

      .join(
        "\n"
      );

}


function saveInfoData() {

  const type =

    document
      .getElementById(
        "admin-info-type"
      )
      .value;


  const lines =

    document
      .getElementById(
        "admin-info-text"
      )
      .value

      .split(
        "\n"
      )

      .map(
        item =>
          item.trim()
      )

      .filter(
        Boolean
      );


  if (
    type === "supplies"
  ) {

    appData.supplies =
      lines;

  }

  else {

    appData.chat =
      lines;

  }


  saveLocalData();


  alert(
    "저장되었습니다."
  );

}


/* =========================
   급식 관리자
========================= */

function loadCurrentLunchData() {

  const day =

