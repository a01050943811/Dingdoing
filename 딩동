<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
>
<title>민준이의 우주 일과표</title>

<style>
:root {
  --bg1: #dff5ff;
  --bg2: #ececff;
  --bg3: #fff6d8;

  --title: #29405f;
  --card: #fffefb;
  --accent: #ffd86b;

  --overlay: rgba(82,108,163,.22);

  --pill: #314563;
  --pillText: #ffe987;

  --text: #253954;

  --check1: #c8f2d0;
  --check2: #9ce4ab;
}

/* =========================
   1. 테마
========================= */

body.theme-sky {
  --bg1: #dff5ff;
  --bg2: #ececff;
  --bg3: #fff6d8;

  --title: #29405f;
  --accent: #ffd86b;

  --pill: #314563;

  --check1: #c8f2d0;
  --check2: #9ce4ab;
}

body.theme-cotton {
  --bg1: #ffe7f3;
  --bg2: #eee7ff;
  --bg3: #fff8df;

  --title: #614e70;
  --accent: #ffc9df;

  --pill: #655276;

  --check1: #f4d9ff;
  --check2: #ddbcf0;
}

body.theme-mint {
  --bg1: #e1fff7;
  --bg2: #e8f5ff;
  --bg3: #fff9df;

  --title: #2d5154;
  --accent: #a9e5d6;

  --pill: #2e5056;

  --check1: #c7f4e5;
  --check2: #96dfc8;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;

  font-family:
    "Malgun Gothic",
    "Apple SD Gothic Neo",
    sans-serif;
}

body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;

  padding: 1vh 0;

  background:
    radial-gradient(
      circle at 12% 15%,
      #fff 0 2px,
      transparent 2.5px
    ),

    radial-gradient(
      circle at 30% 35%,
      #ffffffcc 0 1.5px,
      transparent 2px
    ),

    radial-gradient(
      circle at 72% 20%,
      #fff 0 2px,
      transparent 2.5px
    ),

    radial-gradient(
      circle at 82% 66%,
      #ffffffdd 0 2px,
      transparent 2.5px
    ),

    linear-gradient(
      180deg,
      var(--bg1),
      var(--bg2) 55%,
      var(--bg3)
    );
}


/* =========================
   2. 상단 제목
========================= */

.top-area {
  z-index: 3;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: .7vh;

  width: 100%;
}

.main-title {
  color: var(--title);

  font-weight: 900;
  font-size: 3.1vh;

  background: #ffffffd9;

  padding: 1vh 2.6vh;

  border-radius: 999px;

  box-shadow:
    0 8px 18px #52658f1f;
}


/* =========================
   3. 테마 선택
========================= */

.theme-switcher {
  display: flex;
  gap: 8px;

  flex-wrap: wrap;

  justify-content: center;
}

.theme-chip {
  border: 2px solid #fff;

  background: #fffffff0;

  color: var(--title);

  border-radius: 999px;

  padding: 8px 14px;

  font-weight: 800;

  cursor: pointer;

  min-height: 38px;
}

.theme-chip.active {
  background: var(--accent);
}


/* =========================
   4. 행성 선택 영역
========================= */

.selector-container {
  flex: 1;

  display: flex;

  justify-content: center;
  align-items: center;

  width: 100%;

  min-height: 0;
}

.planet-selector {
  position: relative;

  width: 50vmin;
  height: 50vmin;

  max-width: 500px;
  max-height: 500px;

  border:
    4px dashed #ffffffee;

  border-radius: 50%;

  background:
    #ffffff30;

  box-shadow:
    inset 0 0 35px #ffffff55,
    0 12px 28px #50628a1f;
}

/* 가운데 작은 별 */

.planet-selector::before {
  content: "✨";

  position: absolute;

  left: 45%;
  top: 42%;

  font-size: 3.5vh;

  opacity: .55;
}

.planet-selector::after {
  content: "⭐";

  position: absolute;

  left: 55%;
  top: 55%;

  font-size: 2.2vh;

  opacity: .4;
}


/* =========================
   행성 버튼
========================= */

.planet-btn {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 12vh;
  height: 12vh;

  margin-left: -6vh;
  margin-top: -6vh;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  cursor: pointer;
}

.planet-btn:nth-child(1) {
  transform:
    rotate(-90deg)
    translate(24vmin)
    rotate(90deg);
}

.planet-btn:nth-child(2) {
  transform:
    rotate(-38.6deg)
    translate(25vmin)
    rotate(38.6deg);
}

.planet-btn:nth-child(3) {
  transform:
    rotate(12.8deg)
    translate(25vmin)
    rotate(-12.8deg);
}

.planet-btn:nth-child(4) {
  transform:
    rotate(64.2deg)
    translate(26vmin)
    rotate(-64.2deg);
}

.planet-btn:nth-child(5) {
  transform:
    rotate(115.6deg)
    translate(26vmin)
    rotate(-115.6deg);
}

.planet-btn:nth-child(6) {
  transform:
    rotate(167deg)
    translate(25vmin)
    rotate(-167deg);
}

.planet-btn:nth-child(7) {
  transform:
    rotate(218.4deg)
    translate(25vmin)
    rotate(-218.4deg);
}


/* =========================
   행성 이미지
========================= */

.p-circle {
  width: 9.8vh;
  height: 9.8vh;

  border-radius: 50%;

  margin-bottom: .3vh;

  background-position: center;
  background-repeat: no-repeat;

  box-shadow:
    0 8px 18px #3d52762b,
    0 0 0 6px #ffffff88;

  animation:
    rotatePlanet 35s linear infinite;
}

.p-mercury {
  background-image:
    url(
      'https://science.nasa.gov/wp-content/uploads/2023/11/mercury-messenger-globe-pia15162.jpg'
    );

  background-size: 115%;
}

.p-venus {
  background-image:
    url(
      'https://cf-images.ap-southeast-2.prod.boltdns.net/v1/static/664969388001/2ae03679-5f47-4fba-a983-80deba634e38/8e915729-9a08-4705-ae3e-11fb2112c21a/640x360/match/image.jpg'
    );

  background-size: 200%;
}

.p-earth {
  background-image:
    url(
      'https://images.pexels.com/photos/30596274/pexels-photo-30596274.jpeg'
    );

  background-size: 245%;
}

.p-mars {
  background-image:
    url(
      'https://images.pexels.com/photos/12498801/pexels-photo-12498801.jpeg'
    );

  background-size: 205%;
}

.p-jupiter {
  background-image:
    url(
      'https://images.pexels.com/photos/20337602/pexels-photo-20337602.jpeg'
    );

  background-size: 190%;
}

.p-uranus {
  background-image:
    url(
      'https://images.pexels.com/photos/20337595/pexels-photo-20337595.jpeg'
    );

  background-size: 210%;
}

.saturn-container {
  background: transparent !important;

  box-shadow: none !important;

  animation: none;

  position: relative;
}

.saturn-img {
  position: absolute;

  left: 50%;
  top: 43%;

  transform:
    translate(-50%, -50%);

  width: 13vh;
}

@keyframes rotatePlanet {

  from {
    transform:
      rotate(0deg);
  }

  to {
    transform:
      rotate(360deg);
  }
}


/* =========================
   요일 이름
========================= */

.day-label {
  font-size: 2.2vh;

  font-weight: 900;

  color: var(--title);

  background:
    #fffffff0;

  padding:
    4px 10px;

  border-radius:
    999px;

  min-width: 38px;

  text-align: center;
}


/* =========================
   하단 버튼
========================= */

.bottom-info-bar {
  width: 100%;

  display: flex;

  justify-content: center;
  align-items: center;

  position: relative;

  z-index: 3;

  margin-bottom: .5vh;
}

.center-btns {
  display: flex;

  gap: 3vw;
}

.info-trigger-btn {
  width: 28vw;

  max-width: 360px;

  min-height: 54px;

  padding: 1vh;

  background:
    #fffffff0;

  border:
    3px solid var(--accent);

  border-radius: 22px;

  color: var(--title);

  display: flex;

  align-items: center;
  justify-content: center;

  cursor: pointer;
}

.info-trigger-btn h3 {
  margin: 0;

  font-size: 2.2vh;
}

.right-lock-zone {
  position: absolute;

  right: 4vw;

  background:
    #ffffffbb;

  border-radius: 50%;

  padding:
    8px 10px;

  cursor: pointer;
}


/* =========================
   공통 팝업
========================= */

.modal-overlay {
  display: none;

  position: fixed;

  inset: 0;

  background:
    var(--overlay);

  backdrop-filter:
    blur(8px);

  -webkit-backdrop-filter:
    blur(8px);

  z-index: 1000;

  justify-content: center;
  align-items: center;

  padding:
    2vh 2vw;
}

.schedule-card,
.list-modal-content,
.detail-modal,
.admin-card {
  background:
    var(--card);

  border:
    5px solid var(--accent);

  box-shadow:
    0 14px 34px #3548702e;
}


/* =========================
   일과표
========================= */

.schedule-card {
  width: 95vw;

  max-width: 560px;

  max-height: 94vh;

  border-radius: 28px;

  padding:
    1.5vh 3vw;

  display: flex;

  flex-direction: column;
}

.schedule-card.is-weekday {
  height: 92vh;
}

.schedule-card-header {
  display: flex;

  align-items: center;

  gap: 12px;

  border-bottom:
    3px dashed #dfe6ef;

  padding-bottom:
    1vh;

  margin-bottom:
    1vh;
}

#schedule-title {
  margin: 0;

  color:
    var(--title);

  font-size:
    clamp(
      18px,
      3.4vmin,
      28px
    );

  font-weight: 900;

  white-space: nowrap;
}

.btn-close-schedule,
.close-btn {
  background:
    #304562;

  color:
    #ffe984;

  border: none;

  border-radius:
    16px;

  font-weight: 900;

  cursor: pointer;
}

.btn-close-schedule {
  flex: 1;

  min-height:
    42px;
}

.rect-schedule-box {
  display: flex;

  flex-direction: column;

  gap: .7vh;

  overflow: hidden;
}

.schedule-card.is-weekday
.rect-schedule-box {
  flex: 1;
}

.rect-row {
  display: flex;

  align-items: center;

  border-radius:
    17px;

  padding:
    0 10px;

  min-height:
    65px;

  cursor:
    pointer;

  border:
    2px solid #ffffffb8;
}

.schedule-card.is-weekday
.rect-row {
  flex: 1;

  min-height:
    0;
}

.rect-time {
  width: 42%;

  text-align:
    center;

  font-weight:
    900;

  color:
    #43546d;

  border-right:
    2px dotted #ccd4e0;

  margin-right:
    3vw;

  white-space:
    nowrap;
}

.rect-info {
  display: flex;

  align-items: center;

  gap: 2vw;

  font-weight: 900;

  color:
    var(--text);

  font-size:
    clamp(
      13px,
      3.6vmin,
      20px
    );
}


/* =========================
   교과목 목록
========================= */

.list-modal-content {
  width: 92vw;

  max-width: 560px;

  padding: 20px;

  border-radius: 30px;

  text-align: center;

  display: flex;

  flex-direction: column;

  max-height: 90vh;
}

#list-modal-title,
#info-title,
#modal-title,
#lunch-modal-title {
  color:
    var(--title);

  font-weight:
    900;
}

.schedule-list {
  display: flex;

  flex-direction: column;

  gap: 1.1vh;

  overflow-y:
    auto;

  margin-bottom:
    12px;
}

.schedule-item {
  min-height: 84px;

  display: flex;

  align-items:
    center;

  padding:
    10px 12px;

  background:
    #fff;

  border-radius:
    22px;

  border:
    2px solid #e8eef7;

  cursor:
    pointer;
}

.schedule-item.done {
  background:
    #f7fff7;

  border-color:
    #d5efd9;
}

.item-period-pill {
  width: 22%;

  min-width:
    64px;

  flex-shrink: 0;
}

.item-period-pill span,
.info-pill span {
  display:
    inline-block;

  width:
    100%;

  padding:
    7px 0;

  background:
    var(--pill);

  color:
    var(--pillText);

  border-radius:
    25px;

  font-weight:
    900;
}

.item-content-zone {
  flex: 1;

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  margin-left:
    13px;
}

.subject-badge {
  width:
    58px;

  height:
    58px;

  border-radius:
    17px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  font-size:
    28px;

  flex-shrink:
    0;
}

.item-subject {
  font-size:
    clamp(
      16px,
      2.4vh,
      22px
    );

  color:
    var(--text);

  font-weight:
    900;
}


/* =========================
   체크 버튼
========================= */

.subject-check {
  width:
    46px;

  height:
    46px;

  border-radius:
    50%;

  border:
    2px solid #d9e4f7;

  background:
    #edf3ff;

  color:
    #9aa9bf;

  font-size:
    23px;

  font-weight:
    900;

  cursor:
    pointer;
}

.subject-check.done {
  background:
    linear-gradient(
      180deg,
      var(--check1),
      var(--check2)
    );

  color:
    #fff;

  border-color:
    #fff;
}


/* =========================
   상세 팝업
========================= */

.detail-modal {
  width:
    92vw;

  max-width:
    560px;

  padding:
    25px 20px;

  border-radius:
    30px;

  text-align:
    center;
}

.video-container {
  width:
    100%;

  aspect-ratio:
    16/9;

  background:
    #31405a;

  border-radius:
    18px;

  overflow:
    hidden;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;
}

video {
  width:
    100%;

  height:
    100%;
}

.close-btn {
  width:
    100%;

  padding:
    13px;

  min-height:
    48px;
}


/* =========================
   준비물 / 소통창
========================= */

.info-popup-scroll-container {
  max-height:
    55vh;

  overflow-y:
    auto;

  margin:
    12px 0 18px;
}

.info-item {
  display:
    flex;

  align-items:
    center;

  padding:
    14px;

  margin-bottom:
    11px;

  background:
    #fff;

  border-radius:
    20px;

  border:
    2px solid #e9eef5;
}

.info-pill {
  width:
    25%;

  min-width:
    75px;
}

.info-text-zone {
  flex:
    1;

  margin-left:
    15px;

  color:
    var(--text);

  font-weight:
    800;

  text-align:
    left;
}


/* =========================
   급식
========================= */

.lunch-tray-container,
.admin-tray-layout {
  background:
    linear-gradient(
      135deg,
      #f3f7fb,
      #fff
    );

  border:
    2px solid #d5dce8;

  border-radius:
    20px;

  padding:
    15px;

  display:
    flex;

  flex-direction:
    column;

  gap:
    12px;

  margin:
    10px 0;
}

.tray-row-top,
.tray-row-bottom {
  display:
    flex;

  gap:
    12px;
}

.tray-row-top {
  height:
    11vh;
}

.tray-row-bottom {
  height:
    14vh;
}

.tray-slot {
  flex:
    1;

  background:
    #fff;

  border:
    1px solid #e4e9f1;

  border-radius:
    15px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  font-weight:
    900;

  color:
    var(--text);

  padding:
    8px;

  text-align:
    center;
}


/* =========================
   관리자
========================= */

.admin-card {
  width:
    90vw;

  max-width:
    460px;

  border-radius:
    30px;

  padding:
    24px 20px;

  text-align:
    center;
}

.admin-header {
  font-size:
    24px;

  font-weight:
    900;

  color:
    var(--title);

  margin-bottom:
    20px;
}

.tab-menu-container {
  display:
    flex;

  gap:
    8px;

  margin-bottom:
    20px;
}

.tab-menu-btn {
  flex:
    1;

  padding:
    10px 4px;

  font-weight:
    900;

  background:
    #fff;

  color:
    var(--text);

  border:
    3px solid var(--accent);

  border-radius:
    12px;

  cursor:
    pointer;
}

.tab-menu-btn.active {
  background:
    var(--accent);
}

.tab-content-panel {
  max-height:
    55vh;

  overflow-y:
    auto;

  margin-bottom:
    15px;
}

.field-label {
  text-align:
    center;

  font-weight:
    900;

  color:
    var(--text);

  margin:
    15px 0 8px;
}

.custom-select,
.admin-card input,
.admin-card textarea {
  width:
    100%;

  border:
    2px solid #d8e1ec;

  border-radius:
    15px;

  padding:
    12px;

  font-size:
    16px;

  margin-bottom:
    5px;

  font-family:
    inherit;
}

.action-btn {
  width:
    100%;

  padding:
    14px;

  border:
    none;

  border-radius:
    15px;

  font-weight:
    900;

  font-size:
    18px;

  cursor:
    pointer;

  margin-top:
    10px;
}

.btn-green {
  background:
    #62cb91;

  color:
    #fff;
}

.btn-grey {
  background:
    #4e617d;

  color:
    #ffe984;
}


/* =========================
   접근성
========================= */

@media (
  prefers-reduced-motion:
  reduce
) {

  .p-circle {
    animation:
      none !important;
  }
}


/* =========================
   모바일 / 태블릿
========================= */

@media (
  max-width:
  768px
) {

  .main-title {
    font-size:
      2.55vh;
  }

  .theme-chip {
    font-size:
      12px;

    padding:
      7px 11px;
  }

  .planet-selector {
    width:
      72vmin;

    height:
      72vmin;
  }

  .planet-btn {
    width:
      14vh;

    height:
      14vh;

    margin-left:
      -5vh;

    margin-top:
      -5vh;
  }

  .planet-btn:nth-child(1) {
    transform:
      rotate(-98deg)
      translate(37vmin)
      rotate(98deg);
  }

  .planet-btn:nth-child(2) {
    transform:
      rotate(-46.6deg)
      translate(36vmin)
      rotate(46.6deg);
  }

  .planet-btn:nth-child(3) {
    transform:
      rotate(4.8deg)
      translate(33vmin)
      rotate(-4.8deg);
  }

  .planet-btn:nth-child(4) {
    transform:
      rotate(56.2deg)
      translate(35vmin)
      rotate(-56.2deg);
  }

  .planet-btn:nth-child(5) {
    transform:
      rotate(107.6deg)
      translate(37vmin)
      rotate(-107.6deg);
  }

  .planet-btn:nth-child(6) {
    transform:
      rotate(159deg)
      translate(39vmin)
      rotate(-159deg);
  }

  .planet-btn:nth-child(7) {
    transform:
      rotate(210.4deg)
      translate(41vmin)
      rotate(-210.4deg);
  }

  .p-circle {
    width:
      8.1vh;

    height:
      8.1vh;
  }

  .day-label {
    font-size:
      1.95vh;
  }

  .info-trigger-btn {
    width:
      34vw;
  }

  .schedule-card.is-weekday {
    height:
      94vh;
  }

  .subject-badge {
    width:
      54px;

    height:
      54px;
  }

  .subject-check {
    width:
      44px;

    height:
      44px;
  }
}
</style>
</head>


<body class="theme-sky">


<!-- =========================
     상단
========================= -->

<div class="top-area">

  <div class="main-title">
    🚀 민준이의 우주 일과표
  </div>

  <div class="theme-switcher">

    <button
      class="theme-chip active"
      data-theme="theme-sky"
