/* =========================
   일과표 열기
========================= */

function openSchedule(
  day
) {

  document
    .getElementById(
      "schedule-title"
    )
    .innerText =

      "⭐ "
      +
      day
      +
      " 일과표 ⭐";


  const card =
    document.getElementById(
      "main-schedule-card"
    );


  card.classList.toggle(

    "is-weekday",

    !(
      day === "토요일"
      ||
      day === "일요일"
    )

  );


  const container =
    document.getElementById(
      "rect-schedule-box"
    );


  container.innerHTML =
    "";


  getDayScheduleRect(
    day
  )
  .forEach(

    task => {

      const row =
        document.createElement(
          "div"
        );


      row.className =
        "rect-row";


      row.style.background =
        task.bg;


      row.innerHTML = `

        <div class="rect-time">

          ${formatRealTime(task.s)}
          ~
          ${formatRealTime(task.e)}

        </div>


        <div class="rect-info">

          <span>
            ${task.icon}
          </span>

          <span>
            ${task.label}
          </span>

        </div>

      `;


      row.onclick =
        () => {

          if (
            task.eventId
            ===
