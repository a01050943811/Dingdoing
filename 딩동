          ) {

            openLunchPopup(
              day
            );

          }

          else if (
            task.label
            ===
            "오전수업"
          ) {

            openListModal(
              day,
              "morning"
            );

          }

          else if (
            task.label
            ===
            "오후수업"
          ) {

            openListModal(
              day,
              "afternoon"
            );

          }

          else {

            openVideoModal(

              day,

              task.eventId,

              task.label

            );

          }

        };


      container.appendChild(
        row
      );

    }

  );


  document
    .getElementById(
